<Window x:Class="MicRecorder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mic Recorder — configurações" Height="680" Width="500"
        MinHeight="600" MinWidth="440"
        WindowStartupLocation="CenterScreen"
        Background="#1B1F24">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E6E6E6"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="#2A2F37"/>
            <Setter Property="Foreground" Value="#E6E6E6"/>
            <Setter Property="BorderBrush" Value="#3A4048"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Mic Recorder" FontSize="20" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" Text="Grava o que você fala e o que você ouve, o dia inteiro. Fica rodando na bandeja do sistema." Foreground="#9AA3AD" TextWrapping="Wrap" Margin="0,0,0,14"/>

        <!-- Microfone -->
        <TextBlock Grid.Row="2" Text="Microfone (sua voz)" Margin="0,0,0,4"/>
        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="MicDeviceComboBox" Grid.Column="0" Margin="0,0,8,0" SelectionChanged="MicDeviceComboBox_SelectionChanged"/>
            <Button x:Name="RefreshDevicesButton" Grid.Column="1" Content="Atualizar" Click="RefreshDevicesButton_Click"/>
        </Grid>

        <!-- Saída de som -->
        <TextBlock Grid.Row="4" Text="Saída de som (o que você ouve)" Margin="0,0,0,4"/>
        <ComboBox Grid.Row="5" x:Name="SystemDeviceComboBox" Margin="0,0,0,10" SelectionChanged="SystemDeviceComboBox_SelectionChanged"/>

        <!-- Configurações de silêncio -->
        <Expander Grid.Row="6" Header="Configurações de segmentação" Foreground="#E6E6E6" Margin="0,0,0,10">
            <StackPanel Margin="4,10,4,0">
                <TextBlock Text="Sensibilidade de silêncio"/>
                <Slider x:Name="ThresholdSlider" Minimum="0.002" Maximum="0.08" Value="0.02" TickFrequency="0.002"/>
                <TextBlock Text="Pausa necessária para dividir o arquivo (segundos)" Margin="0,8,0,0"/>
                <Slider x:Name="GapSlider" Minimum="0.5" Maximum="6" Value="2" TickFrequency="0.5"/>
            </StackPanel>
        </Expander>

        <!-- Nível de áudio -->
        <StackPanel Grid.Row="7" Margin="0,0,0,10">
            <TextBlock Text="Você falando"/>
            <ProgressBar x:Name="MicLevelBar" Height="10" Minimum="0" Maximum="1" Value="0" Foreground="#D9A441" Margin="0,2,0,8"/>
            <TextBlock Text="Você ouvindo"/>
            <ProgressBar x:Name="SystemLevelBar" Height="10" Minimum="0" Maximum="1" Value="0" Foreground="#4EA1D3" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Controles -->
        <StackPanel Grid.Row="8" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="StartStopButton" Content="Iniciar gravação" Width="160" Click="StartStopButton_Click"/>
            <Button x:Name="OpenFolderButton" Content="Abrir pasta" Margin="8,0,0,0" Click="OpenFolderButton_Click"/>
        </StackPanel>

        <!-- Status -->
        <TextBlock Grid.Row="9" x:Name="StatusText" Text="Parado." Foreground="#9AA3AD" Margin="0,0,0,10"/>

        <!-- Lista de segmentos gravados -->
        <TextBlock Grid.Row="10" Text="Sessões gravadas:" Margin="0,0,0,4"/>
        <ListBox Grid.Row="11" x:Name="RecordingsList" Background="#20252B" Foreground="#E6E6E6" BorderBrush="#3A4048"/>
    </Grid>
</Window>
