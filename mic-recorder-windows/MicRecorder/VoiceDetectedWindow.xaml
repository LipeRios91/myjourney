<Window x:Class="MicRecorder.VoiceDetectedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mic Recorder"
        Width="300" Height="120"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#1B1F24"
        BorderBrush="#3A4048"
        BorderThickness="1">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Detectei que você começou a falar" FontWeight="Bold" FontSize="14" Foreground="#E6E6E6" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="1" Text="Quer iniciar a gravação do dia agora?" Foreground="#9AA3AD" Margin="0,4,0,0" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="DeclineButton" Content="Agora não" Padding="10,6" Margin="0,0,8,0"
                    Background="#2A2F37" Foreground="#E6E6E6" BorderBrush="#3A4048" Click="DeclineButton_Click"/>
            <Button x:Name="AcceptButton" Content="Gravar" Padding="10,6"
                    Background="#D9A441" Foreground="#1B1F24" FontWeight="Bold" BorderBrush="#D9A441" Click="AcceptButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
