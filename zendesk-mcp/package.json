{
  "name": "zendesk-mcp-server",
  "version": "1.0.0",
  "description": "Servidor MCP para acesso ao ambiente Zendesk (Ticketing API + Help Center API), baseado na referência oficial https://developer.zendesk.com/api-reference/",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "zendesk-mcp-server": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "inspector": "npx @modelcontextprotocol/inspector node src/index.js",
    "package": "npx --yes @anthropic-ai/mcpb pack ."
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "zod": "^4.0.0"
  },
  "license": "UNLICENSED",
  "private": true
}
