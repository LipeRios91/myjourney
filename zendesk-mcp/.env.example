# Copie este arquivo para ".env" (NÃO versionado, ver .gitignore) e preencha
# com as credenciais do SEU ambiente Zendesk. Nunca commite o arquivo ".env".

# Subdomínio do Zendesk, sem ".zendesk.com".
# Ex: se sua URL é https://minhaempresa.zendesk.com, use "minhaempresa".
ZENDESK_SUBDOMAIN=

# E-mail da conta usada para autenticar (precisa ter permissão de API habilitada).
ZENDESK_EMAIL=

# Token de API — RECOMENDADO. Gere em:
# Admin Center > Apps e integrações > APIs > API do Zendesk > "Adicionar token de API".
# Referência oficial: https://developer.zendesk.com/api-reference/introduction/security-and-auth/#api-token
ZENDESK_API_TOKEN=

# Alternativa NÃO recomendada ao token acima (senha da própria conta).
# Só defina uma das duas: ZENDESK_API_TOKEN ou ZENDESK_PASSWORD.
# ZENDESK_PASSWORD=
